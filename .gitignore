# Artefactos de Python (se regeneran solos)
__pycache__/
*.py[cod]
*.egg-info/

# Checkpoints de Jupyter
.ipynb_checkpoints/

# Entornos virtuales
.venv/
venv/

# CODESYS: opciones de usuario y archivo de bloqueo del proyecto abierto
*.opt
*.~u
# CODESYS: información de compilación (se regenera al compilar, ~13 MB)
*.compileinfo
*.precompilecache

# Respaldo automático de FluidSIM
*.bak

# Archivos de sistema y de Office
.DS_Store
Thumbs.db
~$*
